/* =========================================================
   设计语言：Apple 式简约 + 贴纸感（动效增强版）
   浅中性底 + 白色大圆角卡 + 柔和弥散阴影 + 单一强调色 + 大留白
   ========================================================= */

page {
  /* —— 色彩令牌（中性 + 单一强调蓝）—— */
  --c-sky-mist:   #EAF3FF;
  --c-sky-soft:   #F2F6FC;
  --c-klein:      #0071E3;
  --c-klein-deep: #0058C9;
  --c-mint:       #34A88C;
  --c-coral:      #FF3B30;
  --c-han-red:    #D64541;
  --c-honey:      #FFF3C4;
  --c-cream:      #F7F7F9;
  --c-paper:      #FFFFFF;
  --c-ink:        #1D1D1F;
  --c-ink-soft:   #55565C;
  --c-mute:       #86868B;
  --c-card:       #FFFFFF;
  --c-border:     #E5E5EA;

  /* —— 阴影 / 圆角：弥散柔和 —— */
  --shadow-sticker: 0 6rpx 24rpx rgba(0, 0, 0, 0.05);
  --shadow-soft:    0 12rpx 32rpx rgba(0, 0, 0, 0.06);
  --shadow-press:   0 2rpx 8rpx rgba(0, 113, 227, 0.18);
  --shadow-lift:    0 18rpx 40rpx rgba(0, 113, 227, 0.12);
  --radius-xl:  32rpx;
  --radius-lg:  24rpx;
  --radius-md:  20rpx;
  --radius-sm:  14rpx;
  --radius-pill: 999rpx;

  /* —— 缓动曲线 —— */
  --ease-out: ease-out;
  --ease-in-out: ease-in-out;
  --ease-spring: ease-out;

  background: #F5F5F7;
  color: var(--c-ink);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "SF Pro Text", "Noto Sans CJK KR", sans-serif;
  line-height: 1.6;
  -webkit-font-smoothing: antialiased;
}

/* ===== 装饰层：默认隐藏（页面按需启用） ===== */
.sticker-layer { display: none; pointer-events: none; }
.sk, .sk-emoji, .doodle-chair { display: none; }

/* ===== 卡片：白底大圆角 + 柔和阴影 + 悬浮过渡 ===== */
.stick {
  position: relative;
  background: var(--c-card);
  border: none;
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sticker);
  z-index: 1;
  overflow: visible;
  transition: transform 0.32s ease-out, box-shadow 0.32s ease-out;
}

.stick-sm {
  border-radius: var(--radius-md);
  border: 1rpx solid var(--c-border);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

/* 不倾斜 */
.tilt-l, .tilt-r, .tilt-m { transform: none; }

/* ===== Tag：柔和药丸 ===== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: var(--radius-pill);
  font-size: 23rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
  border: none;
  box-shadow: none;
  background: var(--c-cream);
  color: var(--c-ink-soft);
  transition: transform 0.18s ease-out;
}
.tag:active { transform: scale(0.95); }

.tag-klein  { background: var(--c-sky-mist); color: var(--c-klein-deep); }
.tag-coral  { background: #FFE9E8; color: var(--c-coral); }
.tag-honey  { background: #FFF6D9; color: #8A6D1A; }
.tag-mint   { background: #E5F6F1; color: #1E7A67; }
.tag-paper  { background: var(--c-paper); color: var(--c-ink); border: 1rpx solid var(--c-border); }
.tag-cream  { background: var(--c-cream); color: var(--c-ink-soft); }

/* ===== 标题 ===== */
.doodle-title {
  font-weight: 700;
  letter-spacing: 0.5rpx;
  line-height: 1.2;
  color: var(--c-ink);
  font-family: -apple-system, "PingFang SC", sans-serif;
  position: relative;
  display: inline-block;
}
.doodle-title .accent { color: var(--c-klein); position: relative; }

/* 标题下划线：极淡的强调底色块 */
.doodle-underline { position: relative; display: inline-block; }
.doodle-underline::after {
  content: "";
  position: absolute;
  left: -4rpx; right: -4rpx; bottom: 2rpx;
  height: 12rpx;
  background: rgba(0, 113, 227, 0.14);
  border-radius: 999rpx;
  z-index: -1;
}

/* ===== 主按钮 ===== */
.btn-stick {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 22rpx 32rpx;
  background: var(--c-klein);
  color: #fff;
  border: none;
  border-radius: var(--radius-md);
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.3rpx;
  box-shadow: 0 4rpx 14rpx rgba(0, 113, 227, 0.22);
  transition: all 0.18s ease-out;
  overflow: hidden;
}

/* 按钮：光泽扫过 */
.btn-stick::after {
  content: "";
  position: absolute;
  top: 0; left: -100%;
  width: 60%;
  height: 100%;
  background: linear-gradient(120deg, transparent 0%, rgba(255,255,255,0.35) 50%, transparent 100%);
  transform: skewX(-20deg);
  transition: left 0.55s ease-out;
}
.btn-stick:active::after { left: 130%; }

.btn-stick.tap,
.btn-stick.touch { transform: scale(0.97); opacity: 0.92; box-shadow: var(--shadow-press); }

.btn-stick.btn-coral { background: var(--c-coral); box-shadow: 0 4rpx 14rpx rgba(255, 59, 48, 0.2); }
.btn-stick.btn-honey { background: #FFEDB0; color: var(--c-ink); box-shadow: none; }
.btn-stick.btn-mint  { background: var(--c-mint); color: #fff; }
.btn-stick.btn-paper { background: var(--c-paper); color: var(--c-ink); border: 1rpx solid var(--c-border); }

/* ===== 入场动画：上浮淡入（多级 stagger） ===== */
.pop {
  opacity: 0;
  transform: translateY(18rpx) scale(0.98);
  animation: pop-stick 0.55s ease-out forwards;
}
.pop-1 { animation-delay: 0.04s; }
.pop-2 { animation-delay: 0.08s; }
.pop-3 { animation-delay: 0.12s; }
.pop-4 { animation-delay: 0.16s; }
.pop-5 { animation-delay: 0.20s; }
.pop-6 { animation-delay: 0.24s; }
.pop-7 { animation-delay: 0.28s; }
.pop-8 { animation-delay: 0.32s; }

@keyframes pop-stick {
  0%   { opacity: 0; transform: translateY(18rpx) scale(0.98); }
  60%  { opacity: 1; }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* ===== 按压反馈 ===== */
.press-stick { transition: transform 0.14s ease-out, opacity 0.14s ease; }
.press-stick.tap,
.press-stick.touch { transform: scale(0.97); opacity: 0.85; }

.press-bounce { transition: transform 0.14s ease-out; }
.press-bounce.tap { transform: scale(0.93); }

/* ===== 段落标题 ===== */
.sec-head {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin: 36rpx 32rpx 20rpx;
  padding-top: 0;
}
.sec-title {
  font-size: 36rpx;
  font-weight: 700;
  letter-spacing: 0.3rpx;
  color: var(--c-ink);
}
.sec-emoji { font-size: 40rpx; }

/* ===== 状态点 / 进度条 ===== */
.live-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #34C759;
  box-shadow: 0 0 0 4rpx rgba(52, 199, 89, 0.18);
  animation: live-blink 1.6s ease-in-out infinite;
}
@keyframes live-blink {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 4rpx rgba(52, 199, 89, 0.18); }
  50%      { opacity: 0.5; box-shadow: 0 0 0 10rpx rgba(52, 199, 89, 0); }
}

.progress-track {
  width: 100%;
  height: 16rpx;
  background: var(--c-cream);
  border-radius: 999rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--c-klein) 0%, var(--c-klein-deep) 100%);
  border-radius: 999rpx;
  position: relative;
  transition: width 1.2s ease-out;
  overflow: hidden;
}
/* 进度条高光扫过 */
.progress-fill::after {
  content: "";
  position: absolute;
  top: 0; left: -40%;
  width: 30%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.55), transparent);
  animation: prog-shine 2.2s ease-in-out infinite;
}
@keyframes prog-shine {
  0%   { left: -40%; }
  100% { left: 130%; }
}

/* ===== 通用卡片 ===== */
.card {
  background: var(--c-card);
  border-radius: var(--radius-xl);
  padding: 30rpx 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: var(--shadow-sticker);
  transition: transform 0.3s ease-out, box-shadow 0.3s ease-out;
}
.card:active {
  transform: translateY(2rpx) scale(0.99);
  box-shadow: 0 4rpx 14rpx rgba(0,0,0,0.06);
}

/* =========================================================
   动效原语库（按需调用）
   ========================================================= */

/* —— 渐变流动（标题/品牌色块） —— */
.gradient-flow {
  background: linear-gradient(90deg, var(--c-klein), var(--c-mint), var(--c-klein));
  background-size: 200% 100%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: grad-shift 6s linear infinite;
}
@keyframes grad-shift {
  0%   { background-position: 0% 50%; }
  100% { background-position: 200% 50%; }
}

/* —— 呼吸光晕（强调元素） —— */
.glow-pulse {
  position: relative;
  animation: glow-pulse 2.4s ease-in-out infinite;
}
@keyframes glow-pulse {
  0%, 100% { box-shadow: 0 0 0 0 rgba(0, 113, 227, 0.35); }
  50%      { box-shadow: 0 0 0 16rpx rgba(0, 113, 227, 0); }
}

/* —— 缓慢漂浮（装饰贴纸） —— */
.float-slow { animation: float-y 4.5s ease-in-out infinite; }
.float-mid  { animation: float-y 3.2s ease-in-out infinite; }
.float-fast { animation: float-y 2.4s ease-in-out infinite; }
@keyframes float-y {
  0%, 100% { transform: translateY(0) rotate(0); }
  50%      { transform: translateY(-12rpx) rotate(2deg); }
}

/* —— 摇摆（角贴/标签） —— */
.wiggle { animation: wiggle 3s ease-in-out infinite; transform-origin: center; }
@keyframes wiggle {
  0%, 100% { transform: rotate(-3deg); }
  50%      { transform: rotate(3deg); }
}

/* —— 旋转光环（头像/徽章） —— */
.spin-slow { animation: spin-slow 12s linear infinite; }
@keyframes spin-slow { to { transform: rotate(360deg); } }

/* —— 心跳（重要状态） —— */
.heartbeat { animation: heartbeat 1.6s ease-in-out infinite; }
@keyframes heartbeat {
  0%, 100% { transform: scale(1); }
  20%      { transform: scale(1.12); }
  40%      { transform: scale(1); }
  60%      { transform: scale(1.08); }
  80%      { transform: scale(1); }
}

/* —— 闪烁提示（消息/数字增加） —— */
.flash-once { animation: flash-once 0.6s ease-out; }
@keyframes flash-once {
  0%   { background: rgba(0, 113, 227, 0.25); }
  100% { background: transparent; }
}

/* —— 滑入（左右侧内容） —— */
.to-left  { animation: slide-from-left 0.5s ease-out both; }
.to-right { animation: slide-from-right 0.5s ease-out both; }
@keyframes slide-from-left  { from { opacity: 0; transform: translateX(-24rpx); } to { opacity: 1; transform: translateX(0); } }
@keyframes slide-from-right { from { opacity: 0; transform: translateX(24rpx); }  to { opacity: 1; transform: translateX(0); } }

/* —— 弹跳入场 —— */
.bounce-in { animation: bounce-in 0.55s ease-out both; }
@keyframes bounce-in {
  0%   { opacity: 0; transform: scale(0.6); }
  60%  { opacity: 1; transform: scale(1.05); }
  100% { transform: scale(1); }
}

/* —— 骨架屏：光泽流动 —— */
.shimmer {
  background: linear-gradient(90deg, #ECEEF2 25%, #F7F8FB 50%, #ECEEF2 75%);
  background-size: 400% 100%;
  animation: shimmer-move 1.4s ease infinite;
  border-radius: 8rpx;
}
@keyframes shimmer-move {
  0%   { background-position: 100% 0; }
  100% { background-position: 0 0; }
}

/* —— 数字滚动指示器（待办点） —— */
.tick-dot {
  width: 12rpx; height: 12rpx;
  border-radius: 50%;
  background: var(--c-klein);
  animation: tick-dot 1.4s ease-in-out infinite;
}
@keyframes tick-dot {
  0%, 100% { transform: scale(0.7); opacity: 0.5; }
  50%      { transform: scale(1.1); opacity: 1; }
}

/* —— 录音波形（公用） —— */
.wave-bar {
  display: inline-block;
  width: 8rpx;
  border-radius: 999rpx;
  background: var(--c-klein);
  margin: 0 4rpx;
  animation: wave-eq 1.1s ease-in-out infinite;
}
@keyframes wave-eq {
  0%, 100% { height: 12rpx; opacity: 0.5; }
  50%      { height: 36rpx; opacity: 1; }
}