<view class="page">
  <!-- 贴纸装饰层（纯装饰，置底，避开顶部状态栏与底部操作条） -->
  <view class="sticker-layer">
    <view class="sk sk-float-a" style="top:62%;left:-10rpx;">
      <view class="sk-emoji">🤖</view>
    </view>
    <view class="sk sk-float-c" style="bottom:38%;left:20rpx;">
      <view class="sk-emoji">🐻‍❄️</view>
    </view>
  </view>

  <!-- 公告横幅（管理员发布，全员可见） -->
  <view class="notice-bar" wx:if="{{notice}}">
    <view class="notice-body">
      <text class="notice-tag">📢 公告</text>
      <text class="notice-text" user-select>{{notice.content}}</text>
    </view>
    <view class="notice-close" bindtap="onNoticeClose">✕</view>
  </view>

  <!-- ===== 角色状态栏 ===== -->
  <view class="statusbar stick">
    <view class="sb-avatar" bindtap="onAvatarTap">
      <text>{{character.avatar}}</text>
      <view class="sb-avatar-hint">换</view>
    </view>
    <view class="sb-main">
      <view class="sb-name">{{character.name}}</view>
      <view class="sb-status">
        <view class="status-dot {{status === 'typing' ? 'dot-typing' : ''}}"></view>
        <text>{{character.tagline}} · {{status === 'typing' ? '输入中…' : '在线倾听中'}}</text>
      </view>
    </view>
    <view class="sb-new" wx:if="{{!demoMode}}" bindtap="onNewSession">🔄 新对话</view>
  </view>

  <!-- 演示模式标识（Phase 12） -->
  <view class="demo-mark" wx:if="{{demoMode}}">演示数据 · 预置剧本</view>

  <!-- ===== 进行中的情景条 ===== -->
  <view class="sc-bar" wx:if="{{currentScenario}}">
    <view class="sc-info">
      <text class="sc-ico">{{currentScenario.icon}}</text>
      <view class="sc-txt">
        <view class="sc-name">{{currentScenario.name}} · {{currentScenario.name_ko}}</view>
        <view class="sc-role">你面对：{{currentScenario.ai_role}}</view>
      </view>
    </view>
    <view class="sc-end {{scenarioEnding ? 'sc-end-off' : ''}}" catchtap="onScenarioEnd">
      {{scenarioEnding ? '复盘生成中…' : '结束复盘'}}
    </view>
  </view>

  <!-- ===== 模式切换 ===== -->
  <scroll-view class="modes" scroll-x enable-flex wx:if="{{!demoMode}}">
    <view
      wx:for="{{modes}}"
      wx:key="label"
      class="chip {{currentMode === item.label ? 'chip-on' : ''}}"
      data-mode="{{item}}"
      bindtap="onModeTap"
    >{{item.label}}</view>
  </scroll-view>

  <!-- ===== 话题模板 ===== -->
  <scroll-view class="topics" scroll-x enable-flex wx:if="{{!demoMode}}">
    <view
      wx:for="{{topics}}"
      wx:key="label"
      class="topic-chip"
      data-topic="{{item}}"
      bindtap="onTopicTap"
    >{{item.label}}</view>
  </scroll-view>

  <!-- ===== 消息流 ===== -->
  <scroll-view
    class="messages"
    scroll-y
    scroll-into-view="{{scrollInto}}"
    bindscroll="onMsgScroll"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{index}}"
      class="bubble-row {{item.role}} msg-pop"
    >
      <!-- 情景复盘评分卡（系统消息） -->
      <block wx:if="{{item.role === 'sys'}}">
        <view class="rep-card">
          <view class="rep-head">
            <view class="rep-score-wrap">
              <view class="rep-score">{{item.report.score}}</view>
              <view class="rep-score-cap">/ 100</view>
            </view>
            <view class="rep-title">
              <view class="rep-t1">📋 {{item.report.scene_name}} · 情景复盘</view>
              <view class="rep-t2" wx:if="{{item.report.summary}}">{{item.report.summary}}</view>
            </view>
          </view>
          <view class="rep-sec" wx:if="{{item.report.highlights.length}}">
            <view class="rep-sec-t">✓ 做得好的</view>
            <view class="rep-li rep-li-good" wx:for="{{item.report.highlights}}" wx:key="*this" wx:for-item="h">{{h}}</view>
          </view>
          <view class="rep-sec" wx:if="{{item.report.improvements.length}}">
            <view class="rep-sec-t">⚠ 下次注意</view>
            <view class="rep-li rep-li-bad" wx:for="{{item.report.improvements}}" wx:key="*this" wx:for-item="im">{{im}}</view>
          </view>
        </view>
      </block>

      <block wx:else>
      <view class="ava ava-asst" wx:if="{{item.role === 'assistant'}}">{{character.avatar}}</view>

      <view class="bubble {{item.role}} {{item.pending ? 'pending' : ''}}">
        <!-- 等待首字 -->
        <block wx:if="{{item.pending}}">
          <view class="pending-inner">
            <text class="pending-label">老师在想</text>
            <view class="dots"><view class="d"></view><view class="d"></view><view class="d"></view></view>
          </view>
        </block>

        <!-- 富文本渲染（完成后） -->
        <block wx:elif="{{item.blocks && item.blocks.length}}">
          <view wx:for="{{item.blocks}}" wx:key="index" wx:for-item="blk" wx:for-index="bi">
            <view wx:if="{{blk.type === 'code'}}" class="codeblock">
              <view class="cb-head" wx:if="{{blk.lang}}">{{blk.lang}}</view>
              <text class="cb-body" user-select>
                <text wx:for="{{blk.segs}}" wx:key="index" wx:for-item="seg" class="sg-{{seg.s}}">{{seg.t}}</text>
              </text>
            </view>
            <view wx:else class="line">
              <text user-select space="pre-wrap">
                <text wx:for="{{blk.segs}}" wx:key="index" wx:for-item="seg" class="sg-{{seg.s}}">{{seg.t}}</text>
              </text>
            </view>
          </view>

          <view class="source-list" wx:if="{{item.sources && item.sources.length}}">
            <view class="source-label">参考来源 · 点击复制链接</view>
            <view
              class="source-item"
              wx:for="{{item.sources}}"
              wx:key="url"
              wx:for-item="source"
              data-url="{{source.url}}"
              bindtap="onSourceTap"
            >
              <text class="source-title">{{source.title}}</text>
              <text class="source-date" wx:if="{{source.published_at}}">{{source.published_at}}</text>
            </view>
          </view>

          <!-- 结构化纠错卡（后端 state_patch.errors） -->
          <view class="err-cards" wx:if="{{item.errors && item.errors.length}}">
            <view class="err-card" wx:for="{{item.errors}}" wx:key="index" wx:for-item="err">
              <view class="ec-head">
                <view class="ec-type">✏️ {{err.typeLabel}}</view>
                <view class="ec-point" wx:if="{{err.point}}">{{err.point}}</view>
                <view class="ec-sev-high" wx:if="{{err.severity === 'high'}}">易错</view>
              </view>
              <view class="ec-line">
                <text class="ec-wrong">{{err.wrong}}</text>
                <text class="ec-arrow">→</text>
                <text class="ec-right">{{err.right}}</text>
              </view>
              <view class="ec-explain" wx:if="{{err.explain}}">{{err.explain}}</view>
            </view>
          </view>

          <!-- 掌握祝贺卡（错误记忆闭环：再检测 → 掌握） -->
          <view class="mas-cards" wx:if="{{item.mastered && item.mastered.length}}">
            <view class="mas-card" wx:for="{{item.mastered}}" wx:key="index" wx:for-item="m">
              <view class="mas-title">🎉 已掌握「{{m.point}}」的使用！</view>
              <view class="mas-line" wx:if="{{m.wrong}}">
                <text class="mas-wrong">{{m.wrong}}</text>
                <text class="mas-arrow">→</text>
                <text class="mas-right">{{m.right}}</text>
              </view>
            </view>
          </view>

          <!-- 操作条 -->
          <view class="ops" wx:if="{{item.role === 'assistant'}}">
            <view class="op tag tag-cream" data-speech="{{item.speech || item.text}}" bindtap="onSpeakTap">🔊 读</view>
            <view class="op tag tag-paper" data-text="{{item.text}}" bindtap="onCopyTap">📋 复制</view>
            <view
              class="op tag tag-mint"
              wx:if="{{item.korean && item.korean.length}}"
              data-sentence="{{item.korean[0]}}"
              bindtap="onFollowTap"
            >🎤 跟读</view>
          </view>
        </block>

        <!-- 流式打字中 / 纯文本 -->
        <block wx:else>
          <text user-select space="pre-wrap">{{item.text}}</text>
        </block>
      </view>

      <view class="ava ava-user" wx:if="{{item.role === 'user'}}">🧑</view>
      </block>
    </view>

    <view class="msg-end"></view>
  </scroll-view>

  <!-- ===== 录音浮层 ===== -->
  <view class="rec-mask" wx:if="{{recording}}">
    <view class="rec-card">
      <view class="rec-badge tag tag-coral">LIVE</view>
      <view class="wavebars">
        <view class="bar b1"></view>
        <view class="bar b2"></view>
        <view class="bar b3"></view>
        <view class="bar b4"></view>
        <view class="bar b5"></view>
        <view class="bar b6"></view>
        <view class="bar b7"></view>
      </view>
      <view class="rec-hint">正在听你说韩语…</view>
      <view class="rec-sub">已录 {{recordTime}}s / 30s</view>
      <view class="rec-stop" bindtap="onVoiceEnd">⏹ 结束并识别</view>
      <view class="rec-tip">松开 🎤 或点上方按钮结束</view>
    </view>
  </view>

  <!-- ===== 情景选择面板（底部弹层） ===== -->
  <view class="sheet-mask {{scenarioSheet ? 'sheet-mask-on' : ''}}" bindtap="onSheetClose"></view>
  <view class="sheet {{scenarioSheet ? 'sheet-up' : ''}}">
    <view class="sheet-head">
      <text class="sheet-title">역할극 情景对练</text>
      <view class="sheet-close" bindtap="onSheetClose">✕</view>
    </view>
    <scroll-view scroll-y class="sheet-body">
      <view class="sheet-hint">选择一个真实生活场景，AI 扮演其中的角色，陪你完成任务。</view>
      <view class="sc-cat" wx:for="{{scenarioGroups}}" wx:key="cat" wx:for-item="grp">
        <view class="sc-cat-name">{{grp.cat}}</view>
        <view class="sc-grid">
          <view
            class="sc-item"
            wx:for="{{grp.items}}"
            wx:key="id"
            wx:for-item="s"
            data-id="{{s.id}}"
            bindtap="onScenarioTap"
          >
            <view class="si-ico">{{s.icon}}</view>
            <view class="si-info">
              <view class="si-name">{{s.name}}</view>
              <view class="si-meta">
                <text class="si-ko">{{s.name_ko}}</text>
                <text class="si-level">{{s.level}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
    <view style="height: calc(env(safe-area-inset-bottom) + 20rpx);"></view>
  </view>

  <!-- ===== Demo 控制条（Phase 12） ===== -->
  <view class="demo-bar" wx:if="{{demoMode}}">
    <view class="db-btn" bindtap="onDemoExit">退出</view>
    <view class="db-btn" bindtap="onDemoRestart">重置</view>
    <view class="db-next {{demoBusy || demoFinished ? 'db-next-off' : ''}}" bindtap="onDemoNext">
      {{demoFinished ? '演示完成 ✓' : '下一步 →'}}
    </view>
  </view>

  <!-- ===== 底部输入栏 ===== -->
  <view class="ibar" wx:if="{{!demoMode}}">
    <view class="ibtn" bindtap="onUploadTap">📎</view>
    <view class="input-wrap">
      <input
        class="ti"
        value="{{inputText}}"
        placeholder="한국어로 / 用中文或韩语输入"
        placeholder-class="ph"
        confirm-type="send"
        bindinput="onInput"
        bindconfirm="onSend"
      />
    </view>
    <view
      class="ibtn ibtn-mic {{recording ? 'mic-on' : ''}}"
      bindtouchstart="onVoiceStart"
      bindtouchend="onVoiceEnd"
    >🎤</view>
    <view class="ibtn ibtn-tts {{ttsEnabled ? 'tts-on' : ''}}" bindtap="onTtsToggle">
      <text wx:if="{{ttsEnabled}}">🔊</text>
      <text wx:else>🔈</text>
    </view>
    <view class="isend {{inputText ? '' : 'isend-off'}}" bindtap="onSend">보내</view>
  </view>
</view>
