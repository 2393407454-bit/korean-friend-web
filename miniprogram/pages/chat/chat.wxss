/* 聊天页 — K-Blue 贴纸风（动效增强版） */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ===== 装饰层：微弱漂浮贴纸 ===== */
.sticker-layer {
  display: block;
  pointer-events: none;
  position: absolute;
  left: 0; right: 0; top: 0; bottom: 0;
  overflow: hidden;
  z-index: 0;
}
.sk {
  position: absolute;
  font-size: 40rpx;
  opacity: 0.18;
  filter: blur(0.5px);
  z-index: 0;
}
.sk-float-a { animation: float-y 5s ease-in-out infinite; }
.sk-float-b { animation: float-y 4s ease-in-out infinite; animation-delay: -1.5s; }
.sk-float-c { animation: float-y 4.5s ease-in-out infinite; animation-delay: -2.5s; }
.sk-emoji { display: block; line-height: 1; }
/* 装饰元素只在上下边缘与中部漂浮，绝不进顶部状态栏与底部操作条 */
.sk-float-a,
.sk-float-b,
.sk-float-c { max-width: 80rpx; }
.sk-float-a .sk-emoji,
.sk-float-b .sk-emoji,
.sk-float-c .sk-emoji { display: block; }

/* ===== 角色状态栏 ===== */
.statusbar {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  margin: 24rpx 24rpx 6rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--c-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sticker);
  transition: transform 0.3s ease-out, box-shadow 0.3s ease-out;
}
.statusbar:active { transform: translateY(1rpx); }

.sb-avatar {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--c-klein), var(--c-klein-deep));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
  transition: transform 0.3s ease-out;
  box-shadow: 0 4rpx 14rpx rgba(0, 113, 227, 0.28);
}
.sb-avatar:active { transform: scale(0.92); }
/* 头像光环：在线时持续旋转 */
.sb-avatar::before {
  content: "";
  position: absolute;
  inset: -6rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--c-klein) 0%, transparent 50%, var(--c-klein) 100%);
  opacity: 0.35;
  z-index: -1;
  animation: spin-slow 8s linear infinite;
}

.sb-avatar-hint {
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  font-size: 18rpx;
  background: var(--c-honey);
  color: var(--c-ink);
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
  font-weight: 700;
}

.sb-main { flex: 1; min-width: 0; }

.sb-name {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--c-ink);
  letter-spacing: 0.5rpx;
}

.sb-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--c-ink-soft);
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #22C55E;
  position: relative;
  animation: dot-pulse 1.6s ease-in-out infinite;
}
.status-dot::after {
  content: "";
  position: absolute;
  inset: -4rpx;
  border-radius: 50%;
  background: rgba(34, 197, 94, 0.3);
  animation: dot-ring 1.6s ease-in-out infinite;
  z-index: -1;
}
.dot-typing { background: var(--c-honey); }
.dot-typing::after { background: rgba(255, 243, 196, 0.5); }

@keyframes dot-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50%      { opacity: 0.6; transform: scale(0.85); }
}
@keyframes dot-ring {
  0%   { transform: scale(0.7); opacity: 0.6; }
  100% { transform: scale(2);   opacity: 0;   }
}

.sb-new {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--c-ink);
  background: var(--c-cream);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  transition: transform 0.2s ease-out, background 0.2s ease;
}
.sb-new:active { transform: scale(0.92); background: var(--c-honey); }

/* ===== 模式切换 ===== */
.modes {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  white-space: nowrap;
  padding: 8rpx 24rpx 0;
}

.chip {
  display: inline-block;
  padding: 10rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: var(--c-card);
  color: var(--c-ink-soft);
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: var(--shadow-sticker);
  transition: all 0.25s ease-out;
  position: relative;
  z-index: 0;
  isolation: isolate;
  overflow: hidden;
  line-height: 1.2;
}
.chip::before {
  content: "";
  position: absolute;
  inset: 0;
  background: var(--c-klein);
  border-radius: 999rpx;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.35s ease-out;
  z-index: -1;
}
.chip-on { color: #fff; }
.chip-on::before { transform: scaleX(1); }
.chip:active { transform: scale(0.94); }

/* ===== 话题模板 ===== */
.topics {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  white-space: nowrap;
  padding: 6rpx 24rpx 4rpx;
}

.topic-chip {
  display: inline-block;
  padding: 8rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  background: var(--c-sky-soft);
  border: 1.5rpx dashed rgba(0, 113, 227, 0.3);
  color: var(--c-klein-deep);
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.25s ease-out;
}
.topic-chip:active {
  background: var(--c-klein);
  color: #fff;
  border-color: var(--c-klein);
  transform: scale(0.96);
}

/* ===== 消息流 ===== */
.messages {
  position: relative;
  z-index: 2;
  flex: 1;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
  overflow-anchor: auto;
}

.bubble-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin: 14rpx 0;
}
.bubble-row.user { justify-content: flex-end; }

/* 消息入场：上浮 + 轻微回弹 */
.msg-pop {
  animation: msg-in 0.45s ease-out;
  animation-fill-mode: backwards;
  transform-origin: bottom center;
}

@keyframes msg-in {
  0%   { opacity: 0; transform: translateY(20rpx) scale(0.92); }
  60%  { opacity: 1; }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

.ava {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 113, 227, 0.25);
  transition: transform 0.25s ease-out;
}
.ava-asst { background: linear-gradient(135deg, var(--c-klein), var(--c-klein-deep)); }
.ava-user { background: linear-gradient(135deg, var(--c-mint), #2A8F77); }
.ava:active { transform: scale(0.9) rotate(-4deg); }

.bubble {
  max-width: 72%;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  line-height: 1.65;
  font-size: 28rpx;
  word-break: break-all;
  color: var(--c-ink);
  position: relative;
  transition: transform 0.25s ease-out;
  box-sizing: border-box;
}
.bubble:active { transform: scale(0.98); }

.bubble.assistant {
  background: var(--c-paper);
  border-top-left-radius: 6rpx;
  box-shadow: 0 4rpx 16rpx rgba(14, 24, 54, 0.06);
}

.bubble.user {
  background: linear-gradient(135deg, var(--c-klein), var(--c-klein-deep));
  color: #fff;
  border-top-right-radius: 6rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 113, 227, 0.3);
}

/* 用户气泡：细微光泽 */
.bubble.user::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 50%;
  background: linear-gradient(180deg, rgba(255,255,255,0.18) 0%, transparent 100%);
  border-radius: 22rpx 22rpx 0 0;
  pointer-events: none;
}

.bubble.pending {
  background: var(--c-cream);
  position: relative;
  overflow: hidden;
}
.bubble.pending::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(0, 113, 227, 0.06), transparent);
  animation: bubble-shine 1.8s ease-in-out infinite;
}
@keyframes bubble-shine {
  0%   { transform: translateX(-100%); }
  100% { transform: translateX(100%); }
}

.pending-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pending-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--c-ink-soft);
}

.dots { display: inline-flex; gap: 10rpx; align-items: center; }
.dots .d {
  display: block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--c-klein);
  animation: dot-jump 1.1s ease-in-out infinite;
}
.dots .d:nth-child(2) { animation-delay: .15s; background: var(--c-sky-mist); }
.dots .d:nth-child(3) { animation-delay: .3s;  background: var(--c-coral); }

@keyframes dot-jump {
  0%, 100% { transform: translateY(0) scale(0.85); opacity: 0.5; }
  50%      { transform: translateY(-8rpx) scale(1.25); opacity: 1; }
}

/* ===== 富文本 ===== */
.line { min-height: 8rpx; }
.sg-b { font-weight: 800; }
.sg-c {
  font-family: Menlo, Consolas, monospace;
  background: var(--c-sky-soft);
  color: var(--c-klein-deep);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  font-size: 26rpx;
}

.codeblock {
  background: linear-gradient(135deg, #0F1530 0%, #1A2244 100%);
  border-radius: 14rpx;
  padding: 16rpx 18rpx;
  margin: 10rpx 0;
  overflow-x: hidden;
  position: relative;
}
/* 代码块顶部高光 */
.codeblock::before {
  content: "";
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
}

.cb-head {
  font-size: 20rpx;
  color: var(--c-sky-mist);
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
  opacity: 0.7;
}

.cb-body {
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: #EAF2FF;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.sg-k { color: #7FD8F0; }
.sg-str { color: #A5E7A0; }
.sg-cm { color: #8A97B8; }

/* ===== 操作条 ===== */
.ops {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 1.5rpx dashed rgba(14, 24, 54, 0.18);
  animation: ops-in 0.4s ease-out 0.2s both;
}
@keyframes ops-in {
  from { opacity: 0; transform: translateY(-6rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.op {
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: var(--c-cream);
  color: var(--c-klein-deep);
  transition: all 0.2s ease-out;
  cursor: pointer;
}
.op:active {
  transform: scale(0.9);
  background: var(--c-klein);
  color: #fff;
}
.source-list { margin-top: 14rpx; padding-top: 10rpx; border-top: 1rpx solid rgba(14, 24, 54, 0.12); }
.source-label { margin-bottom: 6rpx; color: var(--c-mute); font-size: 21rpx; font-weight: 700; }
.source-item { display: flex; flex-wrap: wrap; gap: 8rpx; padding: 5rpx 0; color: var(--c-klein-deep); font-size: 22rpx; line-height: 1.4; }
.source-date { color: var(--c-mute); }

.msg-end { height: 20rpx; }

/* ===== 结构化纠错卡（Phase 5） ===== */
.err-cards {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.err-card {
  background: #FFF7F6;
  border: 1rpx solid #FFE7E4;
  border-left: 6rpx solid var(--c-han-red);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  animation: ops-in 0.35s ease-out both;
}
.ec-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}
.ec-type {
  font-size: 20rpx;
  font-weight: 700;
  color: #C0392B;
  background: #FFE9E8;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}
.ec-point {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--c-ink-soft);
  background: #FFFFFF;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}
.ec-sev-high {
  font-size: 20rpx;
  font-weight: 700;
  color: #8A6D1A;
  background: #FFF6D9;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
}
.ec-line {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  font-size: 27rpx;
  line-height: 1.5;
}
.ec-wrong { color: var(--c-han-red); text-decoration: line-through; font-weight: 600; }
.ec-arrow { margin: 0 12rpx; color: var(--c-mute); }
.ec-right { color: #1E7A67; font-weight: 700; }
.ec-explain {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--c-mute);
  line-height: 1.55;
}

/* ===== 掌握祝贺卡（Phase 6 错误记忆闭环） ===== */
.mas-cards {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.mas-card {
  background: #F0FAF6;
  border: 1rpx solid #D8F0E7;
  border-left: 6rpx solid var(--c-mint);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  animation: ops-in 0.35s ease-out both;
}
.mas-title {
  font-size: 24rpx;
  font-weight: 700;
  color: #1E7A67;
}
.mas-line {
  margin-top: 8rpx;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  font-size: 25rpx;
  line-height: 1.5;
}
.mas-wrong { color: var(--c-mute); text-decoration: line-through; }
.mas-arrow { margin: 0 10rpx; color: var(--c-mute); }
.mas-right { color: #1E7A67; font-weight: 700; }

/* ===== 录音浮层 ===== */
.rec-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(14, 24, 54, 0.55);
  backdrop-filter: blur(5px);
  -webkit-backdrop-filter: blur(5px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9;
  animation: mask-fade 0.25s ease;
}
@keyframes mask-fade { from { opacity: 0; } to { opacity: 1; } }

.rec-card {
  position: relative;
  background: var(--c-card);
  border-radius: var(--radius-xl);
  box-shadow: 0 18rpx 40rpx rgba(0, 113, 227, 0.12);
  padding: 40rpx 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  min-width: 480rpx;
  animation: card-pop 0.4s ease-out;
}
@keyframes card-pop {
  0%   { opacity: 0; transform: scale(0.85) translateY(20rpx); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}

.rec-badge {
  position: absolute;
  top: -18rpx;
  right: -12rpx;
  transform: rotate(6deg);
  background: var(--c-coral);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
  box-shadow: 0 0 0 4rpx rgba(255, 59, 48, 0.2);
  animation: badge-pulse 1.5s ease-in-out infinite;
}
@keyframes badge-pulse {
  0%, 100% { box-shadow: 0 0 0 4rpx rgba(255, 59, 48, 0.2); }
  50%      { box-shadow: 0 0 0 12rpx rgba(255, 59, 48, 0); }
}

.wavebars {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 110rpx;
  margin: 4rpx 0;
}

.wavebars .bar {
  width: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, var(--c-klein), var(--c-coral));
  animation: wave-b 0.9s ease-in-out infinite;
}
.wavebars .b1 { height: 30rpx;  animation-delay: 0s; }
.wavebars .b2 { height: 54rpx;  animation-delay: .08s; }
.wavebars .b3 { height: 80rpx;  animation-delay: .16s; }
.wavebars .b4 { height: 100rpx; animation-delay: .24s; }
.wavebars .b5 { height: 80rpx;  animation-delay: .32s; }
.wavebars .b6 { height: 54rpx;  animation-delay: .4s; }
.wavebars .b7 { height: 30rpx;  animation-delay: .48s; }

@keyframes wave-b {
  0%, 100% { transform: scaleY(0.4); opacity: 0.7; }
  50%      { transform: scaleY(1.15); opacity: 1; }
}

.rec-hint {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--c-ink);
}

.rec-sub {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--c-klein-deep);
  background: var(--c-sky-soft);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-variant-numeric: tabular-nums;
}

/* ===== 底部输入栏 ===== */
.ibar {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: saturate(180%) blur(10px);
  -webkit-backdrop-filter: saturate(180%) blur(10px);
  border-top: 1rpx solid rgba(14, 24, 54, 0.06);
}

.ibtn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: var(--c-cream);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
  transition: all 0.2s ease-out;
}
.ibtn:active {
  transform: scale(0.88) rotate(-4deg);
  background: var(--c-sky-mist);
}

.ibtn-mic { background: var(--c-honey); }
.mic-on {
  background: var(--c-coral);
  color: #fff;
  position: relative;
  animation: mic-pulse 1.4s ease-in-out infinite;
}
.mic-on::before {
  content: "";
  position: absolute;
  inset: -8rpx;
  border-radius: 24rpx;
  border: 3rpx solid var(--c-coral);
  opacity: 0.5;
  animation: mic-ring 1.4s ease-in-out infinite;
}
@keyframes mic-pulse {
  0%, 100% { transform: scale(1); }
  50%      { transform: scale(1.08); }
}
@keyframes mic-ring {
  0%   { transform: scale(0.9); opacity: 0.6; }
  100% { transform: scale(1.6); opacity: 0;   }
}

.ibtn-tts { background: var(--c-paper); }
.tts-on { background: var(--c-mint); color: #fff; }

.input-wrap {
  flex: 1;
  background: var(--c-sky-soft);
  border-radius: var(--radius-md);
  padding: 6rpx 18rpx;
  transition: all 0.25s ease-out;
}
.input-wrap.input-active {
  background: var(--c-paper);
  box-shadow: 0 0 0 3rpx rgba(0, 113, 227, 0.12);
}

.ti {
  font-size: 28rpx;
  color: var(--c-ink);
  padding: 8rpx 4rpx;
}

.ph { color: var(--c-mute); }

.isend {
  flex-shrink: 0;
  background: linear-gradient(135deg, var(--c-klein), var(--c-klein-deep));
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  padding: 16rpx 28rpx;
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 14rpx rgba(0, 113, 227, 0.3);
  transition: all 0.2s ease-out;
  position: relative;
  overflow: hidden;
}
.isend::after {
  content: "";
  position: absolute;
  top: 0; left: 0;
  width: 60%;
  height: 100%;
  background: linear-gradient(120deg, transparent, rgba(255,255,255,0.3), transparent);
  transform: translateX(-180%);
  transition: transform 0.5s ease-out;
}
.isend:active { transform: scale(0.94); }
.isend:active::after { transform: translateX(180%); }

.isend-off {
  background: linear-gradient(135deg, #C8D2E8, #B7C2DD);
  box-shadow: none;
  opacity: 0.85;
}

/* ===== 录音结束按钮 ===== */
.rec-stop {
  margin-top: 6rpx;
  background: linear-gradient(135deg, var(--c-klein), var(--c-klein-deep));
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 113, 227, 0.3);
  transition: transform 0.2s ease-out;
  position: relative;
  overflow: hidden;
}
.rec-stop::after {
  content: "";
  position: absolute;
  top: 0; left: 0;
  width: 60%;
  height: 100%;
  background: linear-gradient(120deg, transparent, rgba(255,255,255,0.35), transparent);
  transform: translateX(-180%);
  transition: transform 0.5s ease-out;
}
.rec-stop:active { transform: scale(0.94); }
.rec-stop:active::after { transform: translateX(180%); }

.rec-tip {
  font-size: 22rpx;
  color: var(--c-mute);
}

/* ===== 公告横幅 ===== */
.notice-bar {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #FFF8E1 0%, #FFEFB8 100%);
  border-radius: 16rpx;
  box-shadow: 0 4rpx 14rpx rgba(255, 200, 50, 0.18);
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  animation: notice-slide 0.45s ease-out;
}
@keyframes notice-slide {
  from { opacity: 0; transform: translateY(-12rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.notice-body { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.notice-tag {
  font-size: 20rpx;
  font-weight: 800;
  color: var(--c-klein-deep);
  letter-spacing: 0.5rpx;
}
.notice-text {
  font-size: 24rpx;
  color: var(--c-ink);
  line-height: 1.5;
}

.notice-close {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--c-ink-soft);
  padding: 4rpx 8rpx;
  border-radius: 8rpx;
  transition: all 0.2s ease-out;
}
.notice-close:active {
  background: rgba(14, 24, 54, 0.08);
  transform: scale(0.85);
}
/* ===== 情景对练（Phase 8） ===== */
.sc-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 24rpx 16rpx;
  padding: 20rpx 24rpx;
  background: linear-gradient(135deg, #EAF3FF, #F2F6FC);
  border: 1rpx solid #DCEDFF;
  border-radius: 20rpx;
  animation: ops-in 0.3s ease-out both;
}
.sc-info { display: flex; align-items: center; min-width: 0; flex: 1; }
.sc-ico { font-size: 40rpx; margin-right: 16rpx; }
.sc-txt { min-width: 0; }
.sc-name { font-size: 26rpx; font-weight: 700; color: var(--c-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sc-role { margin-top: 4rpx; font-size: 21rpx; color: var(--c-mute); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.sc-end {
  flex: none;
  margin-left: 16rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: var(--c-klein);
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  transition: transform 0.18s ease-out, opacity 0.18s ease-out;
}
.sc-end:active { transform: scale(0.95); }
.sc-end-off { opacity: 0.55; }

/* 底部场景面板 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(14, 24, 54, 0.45);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.25s ease-out;
  z-index: 90;
}
.sheet-mask-on { opacity: 1; pointer-events: auto; }
.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  padding: 28rpx 32rpx 0;
  max-height: 72vh;
  transform: translateY(100%);
  transition: transform 0.28s ease-out;
  z-index: 91;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}
.sheet-up { transform: translateY(0); }
.sheet-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.sheet-title { font-size: 32rpx; font-weight: 800; color: var(--c-ink); }
.sheet-close {
  width: 52rpx; height: 52rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: #F2F2F7;
  color: var(--c-mute);
  font-size: 26rpx;
}
.sheet-body { flex: 1; min-height: 0; }
.sheet-hint { font-size: 22rpx; color: var(--c-mute); margin-bottom: 20rpx; }
.sc-cat { margin-bottom: 24rpx; }
.sc-cat-name { font-size: 22rpx; font-weight: 700; color: var(--c-mute); margin-bottom: 12rpx; letter-spacing: 1rpx; }
.sc-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.sc-item {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #F7F8FA;
  border: 1rpx solid #EEF0F4;
  border-radius: 20rpx;
  transition: transform 0.15s ease-out, background 0.15s ease-out;
}
.sc-item:active { transform: scale(0.97); background: var(--c-sky-mist); }
.si-ico { font-size: 40rpx; margin-right: 16rpx; flex: none; }
.si-info { min-width: 0; }
.si-name { font-size: 25rpx; font-weight: 700; color: var(--c-ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.si-meta { margin-top: 4rpx; display: flex; align-items: center; gap: 10rpx; }
.si-ko { font-size: 20rpx; color: var(--c-mute); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.si-level { flex: none; font-size: 18rpx; color: var(--c-klein-deep); background: #EAF3FF; border-radius: 999rpx; padding: 2rpx 10rpx; }

/* 情景复盘评分卡 */
.bubble-row.sys { justify-content: center; }
.rep-card {
  width: 100%;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: var(--shadow-soft);
  border: 1rpx solid #EEF0F4;
  padding: 32rpx;
  animation: rise-rep 0.4s ease-out both;
}
@keyframes rise-rep {
  from { opacity: 0; transform: translateY(18rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
.rep-head { display: flex; align-items: center; }
.rep-score-wrap {
  flex: none;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--c-klein), var(--c-klein-deep));
  color: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(0, 113, 227, 0.25);
}
.rep-score { font-size: 44rpx; font-weight: 800; line-height: 1; }
.rep-score-cap { margin-top: 4rpx; font-size: 18rpx; opacity: 0.85; }
.rep-title { margin-left: 24rpx; min-width: 0; }
.rep-t1 { font-size: 28rpx; font-weight: 700; color: var(--c-ink); }
.rep-t2 { margin-top: 8rpx; font-size: 22rpx; color: var(--c-mute); line-height: 1.5; }
.rep-sec { margin-top: 24rpx; }
.rep-sec-t { font-size: 22rpx; font-weight: 700; color: var(--c-ink-soft); margin-bottom: 10rpx; }
.rep-li {
  font-size: 24rpx;
  line-height: 1.5;
  padding: 6rpx 0 6rpx 28rpx;
  position: relative;
  color: var(--c-ink-soft);
}
.rep-li::before { position: absolute; left: 4rpx; top: 6rpx; }
.rep-li-good::before { content: "✓"; color: #1E7A67; font-weight: 700; }
.rep-li-bad::before { content: "!"; color: #C0392B; font-weight: 700; }

/* ===== Demo 模式：标识 + 控制条（Phase 12） ===== */
/* 顶部标识：紧跟状态栏的琥珀色细胶囊，明确告知评委这是预置剧本数据 */
.demo-mark {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  align-self: center;
  margin: 0 24rpx 4rpx;
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #8A5B00;
  background: rgba(255, 196, 77, 0.18);
  border: 1rpx solid rgba(255, 170, 23, 0.4);
  border-radius: 999rpx;
}

/* 底部控制条：布局与输入栏一致，保证安全区与层级不跳动 */
.demo-bar {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: rgba(255, 255, 255, 0.92);
  backdrop-filter: saturate(180%) blur(10px);
  -webkit-backdrop-filter: saturate(180%) blur(10px);
  border-top: 1rpx solid rgba(14, 24, 54, 0.06);
}

.db-btn {
  flex-shrink: 0;
  padding: 14rpx 26rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--c-klein-deep);
  background: var(--c-cream);
  border-radius: var(--radius-md);
  transition: all 0.2s ease-out;
}
.db-btn:active { transform: scale(0.94); background: var(--c-sky-mist); }

/* 演示主按钮：Han 教练红，与常规"发送"的克莱因蓝区分开 */
.db-next {
  flex: 1;
  text-align: center;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, var(--c-han-red), #B0332F);
  border-radius: var(--radius-md);
  box-shadow: 0 4rpx 14rpx rgba(214, 69, 65, 0.3);
  transition: all 0.2s ease-out;
}
.db-next:active { transform: scale(0.94); }

.db-next-off {
  background: linear-gradient(135deg, #C8D2E8, #B7C2DD);
  box-shadow: none;
  opacity: 0.85;
}
