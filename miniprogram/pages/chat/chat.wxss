/* 聊天页 — K-Blue 贴纸风（与发音/档案页统一，颜色全部走全局变量） */

.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* ===== 角色状态栏（贴纸卡） ===== */
.statusbar {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  margin: 24rpx 24rpx 6rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: var(--c-card);
  border: 3rpx solid var(--c-border);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sticker);
}

.sb-avatar {
  position: relative;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--c-klein);
  border: 2.5rpx solid var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.sb-avatar-hint {
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  font-size: 18rpx;
  background: var(--c-honey);
  color: var(--c-ink);
  border: 2rpx solid var(--c-border);
  border-radius: 999rpx;
  padding: 2rpx 10rpx;
  font-weight: 700;
}

.sb-main { flex: 1; min-width: 0; }

.sb-name {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--c-ink);
}

.sb-status {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--c-ink-soft);
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #22C55E;
  border: 2rpx solid var(--c-border);
  animation: dot-pulse 1.6s ease-in-out infinite;
}

.dot-typing {
  background: var(--c-honey);
}

@keyframes dot-pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.45; transform: scale(0.8); }
}

.sb-new {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--c-ink);
  background: var(--c-cream);
  border: 2.5rpx solid var(--c-border);
  border-radius: 999rpx;
  padding: 10rpx 20rpx;
  box-shadow: 3rpx 3rpx 0 0 var(--c-border);
}

/* ===== 模式切换 ===== */
.modes {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  white-space: nowrap;
  padding: 16rpx 24rpx 4rpx;
}

.chip {
  display: inline-block;
  padding: 12rpx 26rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  background: var(--c-card);
  border: 2.5rpx solid var(--c-border);
  box-shadow: 3rpx 3rpx 0 0 var(--c-border);
  color: var(--c-ink-soft);
  font-size: 26rpx;
  font-weight: 700;
}

.chip-on {
  background: var(--c-klein);
  color: #fff;
}

/* ===== 话题模板 ===== */
.topics {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  white-space: nowrap;
  padding: 8rpx 24rpx 8rpx;
}

.topic-chip {
  display: inline-block;
  padding: 8rpx 22rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  background: var(--c-sky-soft);
  border: 2rpx dashed var(--c-border);
  color: var(--c-klein-deep);
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 消息流 ===== */
.messages {
  position: relative;
  z-index: 2;
  flex: 1;
  padding: 12rpx 24rpx;
  box-sizing: border-box;
}

.bubble-row {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  margin: 18rpx 0;
}

.bubble-row.user { justify-content: flex-end; }

.msg-pop { animation: msg-in 0.4s cubic-bezier(0.34, 1.4, 0.64, 1); }

@keyframes msg-in {
  from { opacity: 0; transform: translateY(14rpx) scale(0.97); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.ava {
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
  border: 2.5rpx solid var(--c-border);
  box-shadow: 3rpx 3rpx 0 0 var(--c-border);
}

.ava-asst { background: var(--c-klein); }
.ava-user { background: var(--c-mint); }

.bubble {
  max-width: 80%;
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  line-height: 1.65;
  font-size: 28rpx;
  word-break: break-all;
  color: var(--c-ink);
}

.bubble.assistant {
  background: var(--c-paper);
  border: 2.5rpx solid var(--c-border);
  box-shadow: 4rpx 4rpx 0 0 var(--c-border);
  border-top-left-radius: 6rpx;
}

.bubble.user {
  background: var(--c-klein);
  color: #fff;
  border: 2.5rpx solid var(--c-border);
  box-shadow: 4rpx 4rpx 0 0 var(--c-border);
  border-top-right-radius: 6rpx;
}

.bubble.pending {
  background: var(--c-cream);
}

.pending-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pending-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--c-ink-soft);
}

.dots { display: inline-flex; gap: 10rpx; align-items: center; }
.dots .d {
  display: block;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--c-klein);
  animation: dot-jump 1.1s ease-in-out infinite;
}
.dots .d:nth-child(2) { animation-delay: .15s; background: var(--c-sky-mist); }
.dots .d:nth-child(3) { animation-delay: .3s; background: var(--c-coral); }

@keyframes dot-jump {
  0%, 100% { transform: translateY(0) scale(0.85); opacity: 0.5; }
  50% { transform: translateY(-6rpx) scale(1.2); opacity: 1; }
}

/* ===== 富文本 ===== */
.line { min-height: 8rpx; }

.sg-b { font-weight: 800; }

.sg-c {
  font-family: Menlo, Consolas, monospace;
  background: var(--c-sky-soft);
  color: var(--c-klein-deep);
  border: 1.5rpx solid var(--c-border);
  border-radius: 6rpx;
  padding: 2rpx 8rpx;
  font-size: 26rpx;
}

.codeblock {
  background: var(--c-ink);
  border-radius: 14rpx;
  border: 2.5rpx solid var(--c-border);
  box-shadow: 3rpx 3rpx 0 0 var(--c-border);
  padding: 16rpx 18rpx;
  margin: 10rpx 0;
  overflow-x: hidden;
}

.cb-head {
  font-size: 20rpx;
  color: var(--c-sky-mist);
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.cb-body {
  font-family: Menlo, Consolas, monospace;
  font-size: 24rpx;
  color: #EAF2FF;
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-all;
}

.sg-k { color: #7FD8F0; }
.sg-str { color: #A5E7A0; }
.sg-cm { color: #8A97B8; }

/* ===== 操作条 ===== */
.ops {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed rgba(14, 24, 54, 0.25);
}

.op {
  padding: 6rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 999rpx;
  background: var(--c-cream);
  color: var(--c-klein-deep);
  border: 2rpx solid var(--c-border);
  box-shadow: 2rpx 2rpx 0 0 var(--c-border);
}

.op:active { transform: translate(2rpx, 2rpx); box-shadow: 0 0 0 0 var(--c-border); }

.msg-end { height: 20rpx; }

/* ===== 录音浮层 ===== */
.rec-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(14, 24, 54, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9;
}

.rec-card {
  position: relative;
  background: var(--c-card);
  border: 3rpx solid var(--c-border);
  border-radius: var(--radius-xl);
  box-shadow: var(--shadow-sticker);
  padding: 40rpx 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  min-width: 480rpx;
}

.rec-badge {
  position: absolute;
  top: -18rpx;
  right: -12rpx;
  transform: rotate(6deg);
  background: var(--c-coral);
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 20rpx;
}

.wavebars {
  display: flex;
  align-items: center;
  gap: 10rpx;
  height: 110rpx;
}

.wavebars .bar {
  width: 12rpx;
  border-radius: 999rpx;
  background: linear-gradient(180deg, var(--c-klein), var(--c-coral));
  border: 2rpx solid var(--c-border);
  animation: wave-b 0.9s ease-in-out infinite;
}
.wavebars .b1 { height: 30rpx; animation-delay: 0s; }
.wavebars .b2 { height: 54rpx; animation-delay: .08s; }
.wavebars .b3 { height: 80rpx; animation-delay: .16s; }
.wavebars .b4 { height: 100rpx; animation-delay: .24s; }
.wavebars .b5 { height: 80rpx; animation-delay: .32s; }
.wavebars .b6 { height: 54rpx; animation-delay: .4s; }
.wavebars .b7 { height: 30rpx; animation-delay: .48s; }

@keyframes wave-b {
  0%, 100% { transform: scaleY(0.4); opacity: 0.7; }
  50% { transform: scaleY(1.1); opacity: 1; }
}

.rec-hint {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--c-ink);
}

.rec-sub {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--c-klein-deep);
  background: var(--c-sky-soft);
  border: 2rpx solid var(--c-border);
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
}

/* ===== 底部输入栏 ===== */
.ibar {
  position: relative;
  z-index: 3;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx calc(env(safe-area-inset-bottom) + 16rpx);
  background: var(--c-card);
  border-top: 3rpx solid var(--c-border);
}

.ibtn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  background: var(--c-cream);
  border: 2.5rpx solid var(--c-border);
  box-shadow: 3rpx 3rpx 0 0 var(--c-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  flex-shrink: 0;
}

.ibtn-mic { background: var(--c-honey); }
.mic-on { background: var(--c-coral); color: #fff; }

.ibtn-tts { background: var(--c-paper); }
.tts-on { background: var(--c-mint); color: #fff; }

.input-wrap {
  flex: 1;
  background: var(--c-sky-soft);
  border: 2.5rpx solid var(--c-border);
  border-radius: var(--radius-md);
  padding: 6rpx 18rpx;
}

.ti {
  font-size: 28rpx;
  color: var(--c-ink);
  padding: 8rpx 4rpx;
}

.ph { color: var(--c-mute); }

.isend {
  flex-shrink: 0;
  background: var(--c-klein);
  color: #fff;
  font-size: 26rpx;
  font-weight: 800;
  padding: 16rpx 28rpx;
  border-radius: var(--radius-md);
  border: 2.5rpx solid var(--c-border);
  box-shadow: 3rpx 3rpx 0 0 var(--c-border);
}

.isend:active { transform: translate(2rpx, 2rpx); box-shadow: 1rpx 1rpx 0 0 var(--c-border); }

.isend-off {
  background: #C8D2E8;
  opacity: 0.85;
}

/* ===== 录音结束按钮 ===== */
.rec-stop {
  margin-top: 6rpx;
  background: var(--c-klein);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
  padding: 18rpx 48rpx;
  border-radius: 999rpx;
  border: 2.5rpx solid var(--c-border);
  box-shadow: 3rpx 3rpx 0 0 var(--c-border);
}

.rec-stop:active { transform: translate(2rpx, 2rpx); box-shadow: 1rpx 1rpx 0 0 var(--c-border); }

.rec-tip {
  font-size: 22rpx;
  color: var(--c-mute);
}

/* ===== 公告横幅 ===== */
.notice-bar {
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  background: #FFF8E1;
  border: 2.5rpx solid var(--c-border);
  border-radius: 16rpx;
  box-shadow: 3rpx 3rpx 0 0 var(--c-border);
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
}

.notice-body { flex: 1; display: flex; flex-direction: column; gap: 6rpx; }

.notice-tag {
  font-size: 20rpx;
  font-weight: 800;
  color: var(--c-klein-deep);
}

.notice-text {
  font-size: 24rpx;
  color: var(--c-ink);
  line-height: 1.5;
}

.notice-close {
  flex-shrink: 0;
  font-size: 26rpx;
  color: var(--c-ink-soft);
  padding: 4rpx 8rpx;
}
