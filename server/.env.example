# ===== 服务 =====
PORT=3000

# ===== LLM（智谱 GLM，以下模型均实测可用且有免费额度）=====
# glm-4.5-flash：对话大脑（指令遵从度好；glm-4-flash 教学合规性差，勿用）
# glm-4.5v：视觉 OCR（glm-4v-flash 韩文幻觉严重，勿用）
# glm-asr-2512：韩语语音识别（与 LLM 同 Key，实测准确）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
LLM_MODEL=glm-4.5-flash
VISION_MODEL=glm-4.5v

# ===== ASR 韩语语音识别（已实测：智谱 glm-asr-2512，与 LLM 同一个 Key）=====
ASR_PROVIDER=openai
ASR_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ASR_API_KEY=
ASR_MODEL=glm-asr-2512

# ===== TTS 韩语语音合成 =====
# 方案 A：智谱 glm-tts（音色 tongtong/female/xiaochen，需账户充值后生效）
# 方案 B：SiliconFlow CosyVoice2-0.5B（免费额度，支持韩语）
TTS_PROVIDER=openai
TTS_BASE_URL=https://open.bigmodel.cn/api/paas/v4
TTS_API_KEY=
TTS_MODEL=glm-tts
TTS_VOICE=tongtong

# ===== 微信安全内容检测（发布上线强烈建议开启）=====
# 需在小程序后台获取 AppID/AppSecret；开启后用户输入先过 msgSecCheck
ENABLE_WX_SECURITY=false
WX_APPID=
WX_SECRET=

# ===== Edge-TTS（默认 TTS 引擎：免费、无需 Key、真机可用）=====
# 韩文段用韩语音色、中文段用中文音色，自动分段拼接
EDGE_TTS_VOICE_KO=ko-KR-SunHiNeural
EDGE_TTS_VOICE_ZH=zh-CN-XiaoxiaoNeural
# 语速：-10% 表示比正常慢 10%（学习者友好）
EDGE_TTS_RATE=-10%

# ===== 留言板 =====
# 企业微信群机器人 Webhook：配置后用户留言会实时推进微信群（微信里直接看）
# 获取方式：微信里建一个企业微信群 → 群设置 → 群机器人 → 添加 → 复制 Webhook 地址
WECOM_WEBHOOK=
# 管理密钥：小程序「我的」页长按版本号，输入此密钥进入管理面板（看留言/发公告）。上线前务必修改！
ADMIN_KEY=kfp-admin
